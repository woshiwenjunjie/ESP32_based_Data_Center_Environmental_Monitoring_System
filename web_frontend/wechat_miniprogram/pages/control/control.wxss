}

.value-status.status-on {
  color: #4ade80;
  background: rgba(34,197,94,0.15);
}

.value-status.status-off {
  color: #94a3b8;
  background: rgba(100,116,139,0.15);
}

/* 右侧滑块区域 */
.slider-wrapper {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 8rpx 0;
}

.slider-track-container {
  position: relative;
  padding: 8rpx 0;
}

.control-slider {
  margin: 0;
  width: 100%;
}

/* 滑块刻度标记 */
.slider-marks {
  display: flex;
  justify-content: space-between;
  padding: 0 8rpx;
  margin-top: 4rpx;
}

.mark {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.mark-line {
  width: 2rpx;
  height: 10rpx;
  background: rgba(255,255,255,0.2);
  border-radius: 1rpx;
  transition: all 0.3s ease;
}

.mark-line.mark-active {
  background: rgba(139,92,246,0.8);
  box-shadow: 0 0 8rpx rgba(139,92,246,0.5);
}

.servo-marks .mark-line.mark-active {
  background: rgba(245,158,11,0.8);
  box-shadow: 0 0 8rpx rgba(245,158,11,0.5);
}

.mark-label {
  font-size: 18rpx;
  color: rgba(232,234,255,0.5);
  font-weight: 500;
}

/* 旧的样式保留兼容 */
.speed-display {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 22rpx 24rpx;
  background: linear-gradient(135deg, rgba(139,92,246,0.1), rgba(124,58,237,0.05));
  border-radius: 18rpx;
  border: 1rpx solid rgba(139,92,246,0.15);
  box-shadow: inset 0 1rpx 0 rgba(255,255,255,0.05);
}

.speed-ring {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, rgba(139,92,246,0.22), rgba(124,58,237,0.1));
  border: 3rpx solid rgba(139,92,246,0.35);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 0 20rpx rgba(139,92,246,0.15);
}

.speed-num {
  font-size: 40rpx;
  font-weight: 900;
  color: #c4b5fd;
  line-height: 1;
  text-shadow: 0 0 20rpx rgba(139,92,246,0.4);
}

.speed-pct {
  font-size: 22rpx;
  font-weight: 700;
  color: rgba(196,181,253,0.75);
  margin-left: 3rpx;
  align-self: flex-end;
  margin-bottom: 8rpx;
}

.speed-detail {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.speed-pwm {
  font-size: 26rpx;
  color: rgba(196,181,253,0.85);
  font-weight: 700;
  font-family: 'SF Mono', 'Consolas', monospace;
  letter-spacing: 1rpx;
}

.speed-status {
  font-size: 22rpx;
  color: rgba(196,181,253,0.55);
  font-weight: 700;
  letter-spacing: 1.5rpx;
}

.motor-slider,
.servo-slider {
  margin: 6rpx 0 2rpx;
}

.preset-row {
  display: flex;
  gap: 10rpx;
}

.preset-row-wide {
  gap: 8rpx;
}

.preset-item {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  border-radius: 12rpx;
  font-size: 24rpx;
  font-weight: 700;
  background: linear-gradient(135deg, rgba(255,255,255,0.06), rgba(255,255,255,0.03));
  color: rgba(232,234,255,0.6);
  border: 1rpx solid rgba(255,255,255,0.1);
  transition: all 0.28s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  letter-spacing: 1rpx;
  box-shadow: inset 0 1rpx 0 rgba(255,255,255,0.05);
}

.preset-item.preset-wider {
  font-size: 22rpx;
  padding: 12rpx 0;
  letter-spacing: 0.5rpx;
}

.preset-item text {
  color: inherit;
}

/* 亮色模式下的预设按钮样式 */
.control-container.light .preset-item {
  background: linear-gradient(135deg, rgba(255,255,255,0.9), rgba(250,248,255,0.95));
  color: rgba(26,21,96,0.7);
  border-color: rgba(99,102,241,0.2);
  box-shadow: 0 2rpx 8rpx rgba(99,102,241,0.06), inset 0 1rpx 0 rgba(255,255,255,0.8);
}

.control-container.light .preset-item.preset-active {
  background: linear-gradient(135deg, rgba(99,102,241,0.2), rgba(139,92,246,0.12)) !important;
  color: #4f46e5 !important;
  border-color: rgba(99,102,241,0.5) !important;
  box-shadow:
    0 0 24rpx rgba(99,102,241,0.15),
    inset 0 1rpx 0 rgba(255,255,255,0.7);
  font-weight: 800;
}

.preset-active {
  background: linear-gradient(135deg, rgba(99,102,241,0.28), rgba(139,92,246,0.18)) !important;
  color: #c7d2fe !important;
  border-color: rgba(99,102,241,0.45) !important;
  box-shadow:
    0 0 24rpx rgba(99,102,241,0.2),
    inset 0 1rpx 0 rgba(255,255,255,0.12);
  font-weight: 800 !important;
}

.preset-tap {
  transform: scale(0.94);
  background: rgba(255,255,255,0.12);
}

.stop-trigger {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 16rpx;
  border-radius: 14rpx;
  background: linear-gradient(135deg, rgba(239,68,68,0.22), rgba(220,38,38,0.12));
  border: 1.5rpx solid rgba(239,68,68,0.38);
  font-size: 26rpx;
  font-weight: 800;
  color: #fca5a5;
  letter-spacing: 3rpx;
  transition: all 0.32s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  position: relative;
  overflow: hidden;
  box-shadow: 0 0 24rpx rgba(239,68,68,0.2), inset 0 1rpx 0 rgba(255,255,255,0.1);
  margin-top: 10rpx;
}

.stop-trigger::before {
  content: '';
  position: absolute;
  inset: 0;
  background: radial-gradient(circle at center, rgba(239,68,68,0.15), transparent 70%);
  opacity: 0;
  transition: opacity 0.3s ease;
}

.stop-trigger:active::before {
  opacity: 1;
}

.stop-trigger[style*="opacity: 1"] {
  animation: stopPulse 2s ease-in-out infinite;
}

@keyframes stopPulse {
  0%, 100% { box-shadow: 0 0 0 0 rgba(239,68,68,0.25); }
  50% { box-shadow: 0 0 20rpx 4rpx rgba(239,68,68,0.1); }
}

.stop-press {
  transform: scale(0.95);
  background: linear-gradient(135deg, rgba(239,68,68,0.32), rgba(220,38,38,0.2)) !important;
  border-color: rgba(239,68,68,0.45) !important;
}

.stop-icon {
  font-size: 26rpx;
  color: #f87171;
  animation: stopIconBlink 1s steps(2) infinite;
}

@keyframes stopIconBlink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.4; }
}

.servo-visualizer {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  padding: 10rpx 0 12rpx;
}

.gauge-track {
  width: 100rpx;
  height: 50rpx;
  border-radius: 50rpx 50rpx 0 0;
  position: relative;
  overflow: visible;
  background: rgba(255,255,255,0.045);
  border: 1rpx solid rgba(255,255,255,0.07);
  border-bottom: none;
  box-shadow: inset 0 2rpx 8rpx rgba(0,0,0,0.15);
}

/* 舵机仪表盘刻度 */
.gauge-marks {
  position: absolute;
  inset: 0;
  border-radius: 50rpx 50rpx 0 0;
  overflow: hidden;
}

.gauge-mark {
  position: absolute;
  bottom: 0;
  left: 50%;
  width: 2rpx;
  height: 42rpx;
  margin-left: -1rpx;
  transform-origin: bottom center;
}

.gauge-mark-line {
  position: absolute;
  top: 0;
  left: 50%;
  width: 2rpx;
  height: 10rpx;
  margin-left: -1rpx;
  background: rgba(255,255,255,0.25);
  border-radius: 1rpx;
  transition: all 0.3s ease;
}

.gauge-mark-line.mark-line-active {
  background: rgba(245,158,11,0.9);
  box-shadow: 0 0 6rpx rgba(245,158,11,0.6);
}

.gauge-mark-label {
  position: absolute;
  top: 12rpx;
  left: 50%;
  transform: translateX(-50%);
  font-size: 14rpx;
