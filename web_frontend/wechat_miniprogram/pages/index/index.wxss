/* ========== YOLO检测结果样式 ========== */
.yolo-result-container {
  margin-top: 20rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 16rpx;
  padding: 20rpx;
  border: 2rpx solid rgba(99, 102, 241, 0.3);
}

.yolo-header {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  margin-bottom: 16rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.1);
}

.yolo-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.yolo-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #fff;
  flex: 1;
}

.yolo-count {
  font-size: 24rpx;
  color: #a78bfa;
  background: rgba(167, 139, 250, 0.15);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  margin-right: 16rpx;
}

.yolo-close {
  font-size: 28rpx;
  color: #94a3b8;
  padding: 8rpx;
}

.yolo-canvas {
  width: 100%;
  height: 400rpx;
  background: #000;
  border-radius: 12rpx;
  overflow: hidden;
  margin-bottom: 16rpx;
}

.detection-scroll-list {
  max-height: 300rpx;
}

.detection-list {
  padding: 0;
}

.detection-item {
  display: flex;
  align-items: center;
  padding: 16rpx;
  margin-bottom: 12rpx;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 10rpx;
  transition: all 0.2s ease;
  border-left: 4rpx solid transparent;
}

.detection-item.active {
  background: rgba(99, 102, 241, 0.2);
  border-left-color: #6366f1;
}

.det-color-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.det-info {
  flex: 1;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.det-label-text {
  font-size: 26rpx;
  font-weight: 500;
  color: #e2e8f0;
}

.det-score-text {
  font-size: 22rpx;
  color: #94a3b8;
}

/* 浅色主题YOLO样式 */
.app-container.light .yolo-result-container {
  background: rgba(255, 255, 255, 0.95);
  border-color: rgba(99, 102, 241, 0.2);
