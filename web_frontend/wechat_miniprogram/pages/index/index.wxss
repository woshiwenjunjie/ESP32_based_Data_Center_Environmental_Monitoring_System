/**index.wxss - 五页面架构样式（现代化设计）**/
@import "/pages/control/control.wxss";

/* ========== 全局容器 ========== */
.app-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: linear-gradient(180deg, #0f0c29 0%, #302b63 50%, #24243e 100%);
  overflow: hidden;
}

/* ========== 顶部标题栏 ========== */
.top-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  background: rgba(255, 255, 255, 0.08);
  backdrop-filter: blur(20px);
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.1);
  position: relative;
  z-index: 100;
}

.header-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.status-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #64748b;
  transition: all 0.3s ease;
}

.status-dot.online {
  background: #22c55e;
  box-shadow: 0 0 12rpx rgba(34, 197, 94, 0.6);
  animation: pulse-dot 2s infinite;
}

.status-dot.offline {
  background: #ef4444;
  box-shadow: 0 0 12rpx rgba(239, 68, 68, 0.6);
}

@keyframes pulse-dot {
  0%, 100% { transform: scale(1); opacity: 1; }
  50% { transform: scale(1.3); opacity: 0.7; }
}

.header-status {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  font-weight: 500;
}

.header-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 2rpx;
  text-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.3);
}

.config-btn {
  font-size: 36rpx;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50%;
  transition: all 0.3s ease;
}

.config-btn:active {
  background: rgba(255, 255, 255, 0.2);
  transform: scale(0.95);
}

.theme-toggle-btn {
  font-size: 40rpx;
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50%;
  transition: all 0.3s ease;
}

.theme-toggle-btn:active {
  transform: scale(0.9);
  background: rgba(255, 255, 255, 0.2);
}

/* ========== 主内容区 Swiper ========== */
.main-swiper {
  flex: 1;
  overflow: hidden;
}

.page-scroll {
  height: 100%;
  padding: 24rpx;
  box-sizing: border-box;
}

/* ========== 第一页：传感器监测 ========== */

/* 报警横幅 */
.alarm-banner {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  background: linear-gradient(135deg, rgba(239, 68, 68, 0.15) 0%, rgba(220, 38, 38, 0.1) 100%);
  border: 2rpx solid rgba(239, 68, 68, 0.4);
  border-radius: 20rpx;
  margin-bottom: 24rpx;
  animation: alarm-shake 0.5s ease-in-out;
  overflow: hidden;
}

.alarm-banner.active {
  animation: alarm-pulse 2s infinite;
}

@keyframes alarm-shake {
  0%, 100% { transform: translateX(0); }
  25% { transform: translateX(-10rpx); }
  75% { transform: translateX(10rpx); }
}

@keyframes alarm-pulse {
  0%, 100% { 
    box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.4);
    background: linear-gradient(135deg, rgba(239, 68, 68, 0.15) 0%, rgba(220, 38, 38, 0.1) 100%);
  }
  50% { 
    box-shadow: 0 0 20rpx 8rpx rgba(239, 68, 68, 0.2);
    background: linear-gradient(135deg, rgba(239, 68, 68, 0.25) 0%, rgba(220, 38, 38, 0.15) 100%);
  }
}

.alarm-icon {
  font-size: 36rpx;
  animation: alarm-icon-bounce 1s infinite;
}

@keyframes alarm-icon-bounce {
  0%, 100% { transform: rotate(0deg); }
  25% { transform: rotate(-15deg); }
  75% { transform: rotate(15deg); }
}

.alarm-scroll {
  flex: 1;
  white-space: nowrap;
}

.alarm-text {
  font-size: 26rpx;
  color: #fecaca;
  font-weight: 500;
  line-height: 1.4;
}

.alarm-dismiss {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.6);
  padding: 8rpx 16rpx;
  font-weight: bold;
}

/* 传感器四宫格 */
.sensor-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.sensor-card {
  position: relative;
  background: rgba(255, 255, 255, 0.08);
  backdrop-filter: blur(16px);
  border-radius: 24rpx;
  padding: 28rpx 24rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.1);
  overflow: hidden;
  transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
}

.sensor-card:active {
  transform: scale(0.97);
  background: rgba(255, 255, 255, 0.12);
}

.sensor-card.alarm {
  border-color: rgba(239, 68, 68, 0.5);
  background: rgba(239, 68, 68, 0.08);
  animation: card-alarm-glow 1.5s infinite;
}

@keyframes card-alarm-glow {
  0%, 100% { box-shadow: 0 0 0 0 rgba(239, 68, 68, 0); }
  50% { box-shadow: 0 0 30rpx 4rpx rgba(239, 68, 68, 0.15); }
}

.sensor-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin-bottom: 16rpx;
}

.temp-icon {
  background: linear-gradient(135deg, rgba(239, 68, 68, 0.25) 0%, rgba(220, 38, 38, 0.15) 100%);
}

.hum-icon {
  background: linear-gradient(135deg, rgba(59, 130, 246, 0.25) 0%, rgba(37, 99, 235, 0.15) 100%);
}

.mq2-icon {
  background: linear-gradient(135deg, rgba(245, 158, 11, 0.25) 0%, rgba(217, 119, 6, 0.15) 100%);
}

.water-icon {
  background: linear-gradient(135deg, rgba(16, 185, 129, 0.25) 0%, rgba(5, 150, 105, 0.15) 100%);
}

.sensor-body {
  position: relative;
  z-index: 2;
}

.sensor-name {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
  font-weight: 600;
  margin-bottom: 8rpx;
  text-transform: uppercase;
  letter-spacing: 1rpx;
}

.sensor-value-row {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
  margin-bottom: 8rpx;
}

.sensor-value {
  font-size: 52rpx;
  font-weight: 800;
  color: #fff;
  letter-spacing: -2rpx;
  line-height: 1;
}

.sensor-unit {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
  font-weight: 600;
}

.sensor-trend-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.trend {
  font-size: 26rpx;
  font-weight: 700;
}

.trend-up { color: #fca5a5; }
.trend-down { color: #86efac; }
.trend-stable { color: rgba(255, 255, 255, 0.4); }

.sensor-desc {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.4);
}

/* 进度条 */
.sensor-bar {
  position: absolute;
  bottom: 0;
  left: 0;
  height: 4rpx;
  border-radius: 0 4rpx 4rpx 0;
  transition: width 0.6s cubic-bezier(0.4, 0, 0.2, 1);
}

.temp-bar { background: linear-gradient(90deg, #ef4444, #f87171); }
.hum-bar { background: linear-gradient(90deg, #3b82f6, #60a5fa); }
.mq2-bar { background: linear-gradient(90deg, #f59e0b, #fbbf24); }
.water-bar { background: linear-gradient(90deg, #10b981, #34d399); }

/* 水位圆形进度条 - 右上角紧凑显示 */
.water-card-body {
  display: flex;
  flex-direction: column;
}

.water-header-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.water-progress-ring {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.progress-circle {
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  animation: ring-rotate 20s linear infinite;
}

@keyframes ring-rotate {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.progress-inner {
  width: 90rpx;
  height: 90rpx;
  border-radius: 50%;
  background: rgba(15, 12, 41, 0.9);
  display: flex;
  align-items: center;
  justify-content: center;
}

.progress-percent {
  font-size: 24rpx;
  font-weight: 800;
  color: #fff;
  letter-spacing: -0.5rpx;
}

/* 低水位 - 绿色 */
.low-water .progress-circle {
  box-shadow: 0 0 16rpx rgba(16, 185, 129, 0.35), inset 0 0 8rpx rgba(16, 185, 129, 0.15);
}
.low-water .progress-percent { color: #34d399; }

/* 中水位 - 蓝色 */
.mid-water .progress-circle {
  box-shadow: 0 0 16rpx rgba(59, 130, 246, 0.35), inset 0 0 8rpx rgba(59, 130, 246, 0.15);
}
.mid-water .progress-percent { color: #60a5fa; }

/* 高水位 - 红色 */
.high-water .progress-circle {
  box-shadow: 0 0 16rpx rgba(239, 68, 68, 0.35), inset 0 0 8rpx rgba(239, 68, 68, 0.15);
  animation: ring-pulse 1.5s ease-in-out infinite, ring-rotate 20s linear infinite;
}
.high-water .progress-percent { color: #f87171; }

@keyframes ring-pulse {
  0%, 100% { transform: scale(1) rotate(var(--rotation, 0deg)); }
  50% { transform: scale(1.05) rotate(var(--rotation, 0deg)); }
}

/* 报警阈值设置面板 */
.alarm-config-panel {
  background: rgba(255, 255, 255, 0.06);
  backdrop-filter: blur(16px);
  border-radius: 24rpx;
  margin-bottom: 24rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.08);
  overflow: hidden;
}

.panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 28rpx;
  cursor: pointer;
  transition: background 0.3s ease;
}

.panel-header:active {
  background: rgba(255, 255, 255, 0.05);
}

.panel-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #fff;
}

.panel-arrow {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
  transition: transform 0.3s ease;
}

.panel-arrow.open {
  transform: rotate(180deg);
}

.panel-content {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  padding: 0 28rpx;
}

.panel-content.open {
  max-height: 600rpx;
  padding: 0 28rpx 28rpx;
}

.threshold-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.08);
}

.th-label {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.85);
  font-weight: 600;
  min-width: 140rpx;
}

.th-inputs {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: 1;
  justify-content: flex-end;
}

.th-input {
  width: 120rpx;
  height: 60rpx;
  background: rgba(255, 255, 255, 0.08);
  border: 2rpx solid rgba(255, 255, 255, 0.15);
  border-radius: 16rpx;
  padding: 0 16rpx;
  font-size: 26rpx;
  color: #fff;
  text-align: center;
}

.th-sep {
  color: rgba(255, 255, 255, 0.4);
  font-size: 24rpx;
}

.th-unit {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
  min-width: 100rpx;
  text-align: right;
}

.save-threshold-btn {
  margin-top: 24rpx;
  width: 100%;
  height: 80rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border: none;
  border-radius: 40rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.35);
  transition: all 0.3s ease;
}

.save-threshold-btn:active {
  transform: scale(0.97);
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.25);
}

.reset-threshold-btn {
  margin-top: 20rpx;
  width: 100%;
  height: 76rpx;
  background: rgba(255, 255, 255, 0.08);
  border: 2rpx solid rgba(245, 158, 11, 0.4);
  border-radius: 38rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #fbbf24;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
}

.reset-threshold-btn:active {
  transform: scale(0.97);
  background: rgba(245, 158, 11, 0.15);
  border-color: rgba(245, 158, 11, 0.6);
}

/* 数据可视化图表 */
.chart-section {
  background: rgba(255, 255, 255, 0.06);
  backdrop-filter: blur(16px);
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.08);
}

.chart-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.chart-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.chart-icon {
  font-size: 32rpx;
}

.chart-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #fff;
}

.chart-range-btns {
  display: flex;
  gap: 8rpx;
  background: rgba(255, 255, 255, 0.08);
  padding: 6rpx;
  border-radius: 28rpx;
}

.range-btn {
  padding: 12rpx 24rpx;
  border-radius: 22rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.5);
  transition: all 0.3s ease;
}

.range-btn.active {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.3);
}

.chart-canvas {
  width: 100%;
  height: 400rpx;
  border-radius: 16rpx;
  background: rgba(0, 0, 0, 0.2);
}

.chart-legend {
  display: flex;
  justify-content: center;
  gap: 28rpx;
  margin-top: 24rpx;
  flex-wrap: wrap;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.05);
  transition: all 0.3s ease;
}

.legend-item.dim {
  opacity: 0.35;
}

.legend-item:active {
  transform: scale(0.95);
}

.legend-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}

.legend-item text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.75);
  font-weight: 500;
}

/* 更新时间 */
.update-info {
  text-align: center;
  padding: 20rpx;
}

.update-time-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.4);
}

/* ========== 第二页：视频流 + 拍照 ========== */

.video-container {
  position: relative;
  width: 100%;
  aspect-ratio: 16/9;
  background: #000;
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.1);
}

.video-feed {
  width: 100%;
  height: 100%;
  display: block;
}

.video-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  background: linear-gradient(145deg, #1a1a2e 0%, #16213e 100%);
}

.placeholder-icon {
  font-size: 80rpx;
  opacity: 0.7;
}

.placeholder-txt {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.5);
  font-weight: 500;
}

.video-overlay-top {
  position: absolute;
  top: 20rpx;
  left: 20rpx;
  z-index: 10;
}

.live-badge {
  display: flex;
  align-items: center;
  gap: 10rpx;
  background: rgba(0, 0, 0, 0.6);
  backdrop-filter: blur(10px);
  padding: 12rpx 24rpx;
  border-radius: 30rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
}

.live-badge text {
  font-size: 24rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 1rpx;
}

.live-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #64748b;
}

.live-dot.live {
  background: #ef4444;
  animation: live-pulse 1.5s infinite;
}

@keyframes live-pulse {
  0%, 100% { opacity: 1; box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.5); }
  50% { opacity: 0.6; box-shadow: 0 0 0 8rpx rgba(239, 68, 68, 0); }
}

.video-overlay-bottom {
  position: absolute;
  bottom: 20rpx;
  right: 20rpx;
  z-index: 10;
}

.stream-status {
  background: rgba(0, 0, 0, 0.6);
  backdrop-filter: blur(10px);
  padding: 10rpx 20rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  color: #4ade80;
  font-family: monospace;
  font-weight: 600;
}

/* 视频控制条 */
.video-controls {
  display: flex;
  gap: 16rpx;
  margin-bottom: 28rpx;
  justify-content: center;
}

.ctrl-btn {
  flex: 1;
  max-width: 200rpx;
  height: 88rpx;
  background: rgba(255, 255, 255, 0.08);
  backdrop-filter: blur(10px);
  border: 2rpx solid rgba(255, 255, 255, 0.15);
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  transition: all 0.3s ease;
}

.ctrl-btn[disabled] {
  opacity: 0.35;
  background: transparent;
  border-color: rgba(255, 255, 255, 0.05);
}

.ctrl-btn:not([disabled]):active {
  transform: scale(0.95);
  background: rgba(255, 255, 255, 0.15);
}

.ctrl-btn.capture-main {
  max-width: 240rpx;
  background: linear-gradient(135deg, #10b981 0%, #059669 100%);
  border-color: transparent;
  box-shadow: 0 8rpx 24rpx rgba(16, 185, 129, 0.35);
}

.ctrl-btn.active {
  background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
  border-color: transparent;
  box-shadow: 0 4rpx 16rpx rgba(59, 130, 246, 0.3);
}

.ctrl-btn.capture-main:active {
  box-shadow: 0 4rpx 12rpx rgba(16, 185, 129, 0.25);
}

.ctrl-icon {
  font-size: 32rpx;
}

.ctrl-btn text:last-child {
  font-size: 26rpx;
  font-weight: 600;
  color: #fff;
}

/* 拍照结果区域 */
.photo-section {
  background: rgba(255, 255, 255, 0.06);
  backdrop-filter: blur(16px);
  border-radius: 24rpx;
  padding: 28rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.08);
}

.photo-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.photo-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #fff;
}

.photo-count {
  font-size: 24rpx;
  color: #4ade80;
  font-weight: 600;
  background: rgba(74, 222, 128, 0.15);
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
}

.photo-display {
  position: relative;
  width: 100%;
  aspect-ratio: 16/9;
  background: rgba(0, 0, 0, 0.3);
  border-radius: 16rpx;
  overflow: hidden;
  border: 2rpx dashed rgba(255, 255, 255, 0.15);
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.photo-display.has-photo {
  border-style: solid;
  border-color: rgba(16, 185, 129, 0.4);
}

.captured-img {
  width: 100%;
  height: 100%;
}

.photo-time-tag {
  position: absolute;
  bottom: 16rpx;
  right: 16rpx;
  background: rgba(0, 0, 0, 0.7);
  backdrop-filter: blur(10px);
  color: #fff;
  padding: 10rpx 20rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.photo-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.empty-icon {
  font-size: 72rpx;
  opacity: 0.4;
}

.empty-hint {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.4);
}

.photo-actions {
  display: flex;
  gap: 16rpx;
}

.action-btn {
  flex: 1;
  height: 80rpx;
  border: none;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
  transition: all 0.3s ease;
}

.action-btn.primary {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.35);
}

.action-btn.danger {
