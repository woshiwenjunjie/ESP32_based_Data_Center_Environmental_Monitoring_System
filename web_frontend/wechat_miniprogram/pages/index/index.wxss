}

/* ========== 控制页面在Swiper内的覆盖样式 ========== */
.control-page-scroll {
  height: 100%;
  padding: 0 !important;
  box-sizing: border-box;
}

.control-page-scroll .control-container {
  min-height: auto !important;
  padding: 24rpx !important;
  padding-bottom: 180rpx !important;
  background: transparent !important;
  overflow: visible;
}

.control-page-scroll .control-container.light {
  background: transparent !important;
}

.control-page-scroll .bg-orb {
  position: absolute !important;
}

.control-page-scroll .control-header {
  display: none !important;
}

.control-page-scroll .bottom-bar {
  display: none !important;
}
