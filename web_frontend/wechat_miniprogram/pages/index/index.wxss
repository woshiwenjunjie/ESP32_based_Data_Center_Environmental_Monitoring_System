/* ========== 底部自定义TabBar（重点美化）========== */
.tabbar {
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(15, 15, 30, 0.95);
  backdrop-filter: blur(30px);
  border-top: 1rpx solid rgba(255, 255, 255, 0.08);
  position: relative;
  z-index: 100;
}

.tab-item {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  padding: 12rpx 32rpx;
  border-radius: 20rpx;
  transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
}

.tab-item:active {
  transform: scale(0.92);
}

.tab-icon-wrap {
  position: relative;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
}

.tab-item.active .tab-icon-wrap {
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.25) 0%, rgba(118, 75, 162, 0.25) 100%);
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.3);
  transform: translateY(-4rpx);
}

.tab-icon {
  font-size: 36rpx;
  transition: all 0.35s ease;
  filter: grayscale(100%) opacity(0.5);
}

.tab-item.active .tab-icon {
  filter: none;
  transform: scale(1.15);
}

.tab-text {
  font-size: 22rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.4);
  transition: all 0.35s ease;
  letter-spacing: 1rpx;
}

.tab-item.active .tab-text {
  color: #fff;
  text-shadow: 0 2rpx 8rpx rgba(102, 126, 234, 0.4);
}

.tab-indicator {
  position: absolute;
  bottom: -4rpx;
  width: 32rpx;
  height: 5rpx;
  background: linear-gradient(90deg, #667eea, #764ba2);
  border-radius: 3rpx;
  box-shadow: 0 2rpx 8rpx rgba(102, 126, 234, 0.5);
  animation: indicator-appear 0.3s ease-out;
}

@keyframes indicator-appear {
  from { 
    width: 0; 
    opacity: 0;
  }
  to { 
    width: 32rpx; 
    opacity: 1;
  }
}

.alarm-dot {
  position: absolute;
  top: 8rpx;
  right: 12rpx;
  width: 16rpx;
  height: 16rpx;
  background: #ef4444;
  border-radius: 50%;
  border: 3rpx solid rgba(15, 15, 30, 0.95);
  animation: alarm-dot-pulse 1.5s infinite;
}

@keyframes alarm-dot-pulse {
  0%, 100% { 
    transform: scale(1);
    box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.5);
  }
  50% { 
    transform: scale(1.2);
    box-shadow: 0 0 0 6rpx rgba(239, 68, 68, 0);
  }
}

